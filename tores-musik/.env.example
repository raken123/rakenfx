# Kopiera den här filen till .env och fyll i nyckeln. .env laddas aldrig upp till GitHub.
OPENAI_API_KEY=sk-...
ASTRA_MODEL=gpt-6-astra
ASTRA_EFFORT=low
TRANSCRIBE_MODEL=gpt-4o-transcribe
PORT=3000
